# Every variable the demo stack reads, with its default as the value.
#
#   cp .env.example .env
#
# Compose picks .env up automatically from this directory; a variable exported
# in your shell still wins over the file. Nothing here is mandatory — the stack
# runs on these defaults — except OLLAMA_API_KEY, which the health assistant
# needs and which has no sensible default.


# ---------------------------------------------------------------- the scenario

# Which telemetry the simulator pushes. One of the TOMLs in imitacija/config/,
# without the extension:
#   badscenario1   SANS, cephalic fluid shift (the scenario we demo)
#   healthy        nominal crew and cabin
#   badscenario2   hypercapnia
#   badscenario3   EVA dehydration
#   badscenario4   acute infection
#   research_demo  six months of sparse labs in ~26 seconds
SCENARIO=badscenario1

# Simulation seconds per wall second, as `make dev SPEED=30` does. Empty keeps
# the pace the scenario itself sets.
# For a clean demo keep it to 3-5
SPEED=5

# Stop after this many simulation seconds. Empty runs until you stop the stack.
DURATION=

# Paired synthetic pressure trends every N simulated seconds, matching the
# Makefile. Blood pressure's real protocol takes its first cuff reading 8
# simulated hours in, so without this the dashboard shows one boot value and
# nothing more. 0 restores the protocol schedule.
BP_DEMO_INTERVAL=5

# The same for blood sugar. The CGM's own 5-minute sensor window puts its first
# completed result 343 simulated seconds into the run, so the chart holds a
# single boot point until then. 0 restores that window.
GLUCOSE_DEMO_INTERVAL=5


# -------------------------------------------------------------- the dashboard

# Published host ports: the dashboard, then the API (Swagger UI at /api/docs/).
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Where the dashboard sends its API calls, baked in at build time. Empty means
# its own origin, which nginx proxies to the backend — right for every local or
# LAN demo. Set an absolute URL only to aim the dashboard at a backend outside
# this stack, and rebuild (`docker compose up --build`) after changing it.
VITE_BACKEND_URL=


# ---------------------------------------------------------------- the database

# 1 empties the database on every launch, so a scenario always plays from its
# own beginning. 0 keeps what the last run recorded.
RESET_DB=1


# ---------------------------------------------------------- the health assistant

# The chat's LLM on Ollama Cloud. Fill this in to enable the assistant; without
# a key the dashboard runs normally and only /api/assistant/ answers 503.
#
# Keep the line commented out rather than empty if you already have the key in
# backend/.env (where `make dev` reads it): an empty value here would be passed
# to the backend and shadow that file.
# OLLAMA_API_KEY=

# Defaults are the backend's own; override only to try another model, endpoint
# or timeout.
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_URL=https://ollama.com/api/chat
OLLAMA_TIMEOUT_S=60

# Per client IP, guarding the assistant endpoint alone.
ASSISTANT_RATE=10/min
ASSISTANT_DAILY_RATE=200/day
